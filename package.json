{
  "name": "secure-notes-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.seed scripts/seed.js",
    "explain": "node --env-file-if-exists=.env scripts/explain.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.3",
    "zod": "4.6.7"
  }
}
